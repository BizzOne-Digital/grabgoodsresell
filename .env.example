MONGODB_URI=mongodb://<username>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/<database>?ssl=true&authSource=admin&replicaSet=<replica-set>&retryWrites=true&w=majority
ADMIN_PASSWORD=your_admin_password
ADMIN_SECRET=your_random_jwt_secret_min_32_chars
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Use Google/Cloudflare DNS for MongoDB when local router DNS is slow (default: enabled)
# MONGODB_USE_PUBLIC_DNS=false
